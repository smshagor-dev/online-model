# Private backend URL: never prefix with NEXT_PUBLIC_.
LARAVEL_API_URL=https://cloud.openmindai.org/api/v1
# Full public origin of this separate Next.js developer portal.
PORTAL_ORIGIN=http://localhost:3100
# Configure this on the server, not in a browser or committed file.
NODE_ENV=development
# Only enable behind ingress that overwrites and validates real client IP headers.
TRUST_PROXY_HEADERS=false
