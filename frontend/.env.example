# Server-only Laravel address. Do not add NEXT_PUBLIC_ to this variable.
LARAVEL_API_URL=http://127.0.0.1:8000/api/v1
# Public frontend origin, used to validate browser mutations.
FRONTEND_URL=http://localhost:3000

# Enable only behind an ingress that overwrites/appends the real client IP.
TRUST_PROXY_HEADERS=false

# Hosted NVIDIA chat runs from the Next.js server; never use NEXT_PUBLIC_ keys.
# Set local for existing self-hosted Hugging Face chat.
CHAT_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Server-side automatic routing; never prefix these with NEXT_PUBLIC_.
NVIDIA_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_REASONING_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_ROUTER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Set false to disable the optional semantic classifier; clear intents still route locally.
NVIDIA_ROUTER_CLASSIFIER=true
# The same server-only key also powers hosted image, speech, document and video endpoints.
# Model-level API access and timeouts must be checked on your account.
# Same random secret (32+ characters) in Laravel .env and Next.js server .env.
FRONTEND_CHAT_BRIDGE_KEY=
